#include <windows.h>

IDI_ICON1 ICON "icons/mykos-whats.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
#ifdef _DEBUG
FILEFLAGS       0x1L
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "MyKOS"
            VALUE "FileDescription",  "MyKOS-Whats - WhatsApp Web Desktop Client"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "MyKOS-Whats"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Ruben (eskib0)"
            VALUE "OriginalFilename", "MyKOS-Whats.exe"
            VALUE "ProductName",      "MyKOS-Whats"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
